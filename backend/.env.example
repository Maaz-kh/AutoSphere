# Copy to .env and fill in real values.

DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=

# TiDB Cloud / MySQL over TLS: path to CA certificate (.pem), relative to backend/ or absolute.
# Example: certs/tidb-ca.pem
# Set to false for local non-SSL MySQL (e.g. localhost).
DB_USE_SSL=true
DB_SSL_CA=

# Optional: set to false only for debugging (not recommended).
# DB_SSL_REJECT_UNAUTHORIZED=true
