# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
!.env.sample
!.env*.example
!backend/.env.example

# --- Dependencies ---
node_modules/

# --- Build & output ---
dist/
build/
out/
.next/
.nuxt/
*.tsbuildinfo

# --- Logs & debug ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Test & coverage ---
coverage/
.nyc_output/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE / editor ---
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code (keep extensions.json if you want shared recommendations committed)
.vscode/*
!.vscode/extensions.json

# --- Misc local / temp ---
tmp/
temp/
.cache/

# Optional: local uploads if you ever switch off cloud storage
uploads/

# TLS CA bundles (e.g. TiDB Cloud); keep paths in .env only
backend/certs/*.pem
